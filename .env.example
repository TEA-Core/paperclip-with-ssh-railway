# Paperclip + SSH Railway template environment variables.
# Copy this file to .env for local reference only.
# In Railway, set these in service variables.

# =============================================================================
# Required Paperclip variables (same as upstream template)
# =============================================================================
DATABASE_URL=${{Postgres.DATABASE_URL}}
BETTER_AUTH_SECRET=${{secret(64, "abcdef0123456789")}}
HOST=0.0.0.0
PORT=3100
SERVE_UI=true
PAPERCLIP_HOME=/paperclip
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_PUBLIC_URL=https://${{Paperclip.RAILWAY_PUBLIC_DOMAIN}}
BETTER_AUTH_BASE_URL=https://${{Paperclip.RAILWAY_PUBLIC_DOMAIN}}

# =============================================================================
# SSH access (key-only, no passwords)
# =============================================================================
# Username for the SSH user. Default: dev
SSH_USERNAME=dev

# REQUIRED: one or more SSH public keys, newline-separated.
# Paste the contents of your ~/.ssh/id_ed25519.pub or id_rsa.pub here.
AUTHORIZED_KEYS=ssh-ed25519 AAAA... your-comment

# =============================================================================
# Optional — agent CLI fallbacks
# =============================================================================
# If you'd rather Paperclip's agents use API keys instead of (or alongside)
# the shared Claude Max OAuth, set these. Both the SSH user and Paperclip's
# internal agents will pick them up.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional GitHub identity for the SSH user
# GH_TOKEN=ghp_...
# GITHUB_NAME=Your Name
# GITHUB_EMAIL=you@example.com

# Optional: pin a different upstream Paperclip release at build time
# PAPERCLIP_REF=v2026.416.0
